#!/bin/sh
# Review gate backstop: pre-commit and commit-msg are skipped by --no-verify,
# this hook is not. Only the `preparing` state can abort the ref update; the
# other states pass through.
set -eu
. "$(dirname "$0")/_lib.sh"

state=${1:-}
refs=$(cat)
run_repo_hook_with_input reference-transaction "$refs" "$state"

test "$state" = preparing || exit 0
gate_active || exit 0
repo=$(repo_root) || exit 0
if repo_exempt "$repo"; then exit 0; fi
if history_in_progress; then exit 0; fi

# The loop must run in this shell: `require_review` exits the hook on a refusal,
# and a pipeline would only exit its subshell. The temp file also keeps a ref
# name out of a here-document, where a `$` in a branch name would expand.
tmp=$(mktemp "${TMPDIR:-/tmp}/review-gate-refs.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$refs" >"$tmp"

while read -r old new ref; do
  if [ -z "${ref:-}" ]; then continue; fi
  case $ref in
    HEAD | refs/heads/*) ;;
    *) continue ;;
  esac
  if ! ref_records_new_commit "$new"; then continue; fi
  tree=$(git rev-parse "$new^{tree}")
  message=$(git log -1 --format=%B "$new" | git stripspace)
  require_review "$repo" "$tree" "$message"
done <"$tmp"
